# cardea NAS stack: copy to .env next to compose.yml on the NAS, fill in, never commit.
# compose.yml declares every setting; this file only holds their values. anything left
# empty here is required, and `docker compose up` names it if it is missing.
#
# generate secrets with hex, not base64: postgres's password ends up inside a URL, and
# base64's + / = would break it.
#   openssl rand -hex 24      passwords and secrets
#   openssl rand -hex 32      ENCRYPTION_KEY (must be exactly 64 hex characters)

# --- langfuse ---
# the address you open langfuse at; sign-in redirects here. only the browser uses it, so a
# .local name is fine; optionally use the NAS's fixed IP, since .local can stall for seconds.
NEXTAUTH_URL=http://truenas.local:3000
NEXTAUTH_SECRET=
SALT=

# changing this once langfuse holds data makes that data unreadable.
ENCRYPTION_KEY=

# set true once your own account exists.
AUTH_DISABLE_SIGNUP=false

# --- langfuse storage ---
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=

# langfuse's three LANGFUSE_S3_*_SECRET_ACCESS_KEY values default to this.
MINIO_ROOT_PASSWORD=

# --- optional ---
# the cloudflare tunnel only starts when this is set.
CLOUDFLARE_TUNNEL_TOKEN=
# who basic memory runs as (uid:gid); 1000 when unset. it must be able to write the notes.
# BASIC_MEMORY_USER=1000:1000
# the basic memory project made the default at each start; none is set when unset.
# BASIC_MEMORY_DEFAULT_PROJECT=
