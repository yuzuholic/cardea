# cardea on the Mac — what install.sh asks for. it writes .env itself; this file only seeds
# `./install.sh --no-prompt`. for the NAS's own secrets, see nas/.env.example.

# --- basic memory (NAS) ---
BASIC_MEMORY_URL=http://truenas.local:8766/mcp

# --- langfuse (NAS) ---
LANGFUSE_HOST=http://truenas.local:3000

# create these in langfuse: settings → api keys. empty keeps tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
