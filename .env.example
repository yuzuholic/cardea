# cardea on the Mac: what install.sh asks for. it writes .env itself; this file only seeds
# `./install.sh --no-prompt`. for the NAS's own secrets, see nas/.env.example.

# .local names resolve over mDNS and can stall for seconds; put the NAS's fixed IP or a router
# DNS name in your own .env, never here.

# --- nas ---
# the NAS host, no port: hindsight is reached on :8888 and langfuse on :3000 of it.
NAS_URL=http://truenas.local

# --- hindsight (NAS) ---
# the bearer token for hindsight's MCP endpoint; the NAS holds the same value as
# HINDSIGHT_MCP_TOKEN. empty skips the hindsight MCP server. install.sh does not ask for it:
# put it here by hand, and it keeps it.
HINDSIGHT_MCP_TOKEN=

# --- langfuse (NAS) ---
LANGFUSE_HOST=http://truenas.local:3000

# create these in langfuse: settings > api keys. empty keeps tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
